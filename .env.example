# Gemma 4 / Google AI Studio / Vision API Configuration
# Option 1: Google AI Studio (Gemini / Gemma API)
GEMMA_API_KEY=your_google_ai_studio_or_gemma_api_key_here
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL=gemma-4-26b-a4b-it


# Fallback mode (true enables offline clinical heuristics if API key is blank)
FALLBACK_MODE=true

# Provider switch: gemma (Google AI Studio) or groq. Each has its own key/base/model.
ACTIVE_PROVIDER=gemma
# If the active provider fails (timeout, rate limit), try the other one before using offline demo data.
AUTO_FAILOVER=true

# Groq (OpenAI-compatible). qwen/qwen3.8-27b reads images and answers in about 2 seconds.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
