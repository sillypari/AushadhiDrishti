# Gemma 4 / Google AI Studio / Vision API Configuration
# Option 1: Google AI Studio (Gemini / Gemma API)
GEMMA_API_KEY=your_google_ai_studio_or_gemma_api_key_here
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL=gemma-4-26b-a4b-it

# Option 2: OpenRouter or Groq or Local vLLM/Ollama (OpenAI Compatible)
# GEMMA_API_KEY=your_groq_or_openrouter_key
# GEMMA_API_BASE=https://api.groq.com/openai/v1
# GEMMA_MODEL=gemma2-9b-it

# Fallback mode (true enables offline clinical heuristics if API key is blank)
FALLBACK_MODE=true
